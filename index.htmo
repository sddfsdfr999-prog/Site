<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Профессии моих родителей</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: 'Segoe UI', Tahoma, sans-serif; background: #0a0e27; overflow: hidden; height: 100vh; color: #fff; }
  .bg { position: fixed; inset: 0; background: linear-gradient(-45deg, #0a0e27, #1a2a5e, #2d1b4e, #0a0e27); background-size: 400% 400%; animation: gradientShift 15s ease infinite; z-index: -2; }
  @keyframes gradientShift { 0%,100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
  .particles { position: fixed; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
  .particles span { position: absolute; font-size: 28px; opacity: 0.15; animation: float 20s linear infinite; }
  @keyframes float { 0% { transform: translateY(110vh) rotate(0deg); } 100% { transform: translateY(-20vh) rotate(360deg); } }
  .progress { position: fixed; top: 0; left: 0; height: 5px; background: linear-gradient(90deg, #ffd93d, #6bcB77, #4d96ff); width: 0%; transition: width 0.4s ease; z-index: 100; box-shadow: 0 0 15px #ffd93d; }
  .counter { position: fixed; bottom: 20px; right: 30px; font-size: 16px; background: rgba(255,255,255,0.1); backdrop-filter: blur(10px); padding: 8px 18px; border-radius: 30px; border: 1px solid rgba(255,255,255,0.15); z-index: 100; font-weight: 600; letter-spacing: 1px; }
  .slide { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 60px 80px; opacity: 0; transform: translateX(60px) scale(0.95); transition: opacity 0.6s ease, transform 0.6s ease; pointer-events: none; text-align: center; }
  .slide.active { opacity: 1; transform: translateX(0) scale(1); pointer-events: auto; }
  .slide.prev { transform: translateX(-60px) scale(0.95); }
  h1 { font-size: clamp(32px, 5vw, 72px); font-weight: 800; background: linear-gradient(90deg, #ffd93d, #6bcB77, #4d96ff); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 25px; line-height: 1.15; }
  h2 { font-size: clamp(26px, 3.5vw, 48px); color: #ffd93d; margin-bottom: 30px; font-weight: 700; }
  p { font-size: clamp(16px, 1.6vw, 22px); line-height: 1.7; max-width: 900px; color: #e0e0e0; margin-bottom: 20px; }
  .title-slide h1 { font-size: clamp(36px, 6vw, 84px); animation: glow 3s ease-in-out infinite alternate; }
  @keyframes glow { from { filter: drop-shadow(0 0 10px rgba(255,217,61,0.3)); } to { filter: drop-shadow(0 0 25px rgba(107,203,119,0.6)); } }
  .emoji-big { font-size: clamp(60px, 10vw, 120px); margin-bottom: 20px; animation: bounce 2s ease-in-out infinite; }
  @keyframes bounce { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-15px); } }
  .author { margin-top: 40px; font-size: clamp(16px, 1.5vw, 22px); color: #a0a0b0; font-style: italic; }
  .stickers { display: flex; gap: 30px; margin-top: 20px; justify-content: center; flex-wrap: wrap; }
  .sticker { font-size: clamp(50px, 7vw, 90px); animation: wobble 3s ease-in-out infinite; }
  .sticker:nth-child(2) { animation-delay: 0.5s; }
  .sticker:nth-child(3) { animation-delay: 1s; }
  @keyframes wobble { 0%,100% { transform: rotate(-5deg) scale(1); } 50% { transform: rotate(5deg) scale(1.1); } }
  ul { list-style: none; text-align: left; max-width: 800px; width: 100%; }
  ul li { font-size: clamp(15px, 1.5vw, 21px); padding: 15px 20px 15px 60px; margin-bottom: 14px; background: rgba(255,255,255,0.05); border-left: 4px solid #ffd93d; border-radius: 12px; position: relative; transition: transform 0.3s, background 0.3s; color: #e8e8e8; }
  ul li::before { content: "▸"; position: absolute; left: 20px; top: 50%; transform: translateY(-50%); font-size: 24px; color: #ffd93d; font-weight: bold; }
  ul li:hover { transform: translateX(10px); background: rgba(255,217,61,0.12); }
  .compare { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; width: 100%; max-width: 1000px; margin-top: 20px; }
  .card { background: rgba(255,255,255,0.06); border-radius: 20px; padding: 30px; backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); transition: transform 0.4s, box-shadow 0.4s; }
  .card:hover { transform: translateY(-8px); }
  .card.dad { border-top: 4px solid #ffd93d; box-shadow: 0 10px 40px rgba(255,217,61,0.15); }
  .card.mom { border-top: 4px solid #6bcB77; box-shadow: 0 10px 40px rgba(107,203,119,0.15); }
  .card h3 { font-size: clamp(20px, 2vw, 28px); margin-bottom: 20px; }
  .card.dad h3 { color: #ffd93d; }
  .card.mom h3 { color: #6bcB77; }
  .card .row { text-align: left; font-size: clamp(14px, 1.3vw, 17px); margin-bottom: 14px; color: #d0d0d0; line-height: 1.5; }
  .card .row b { color: #fff; display: block; margin-bottom: 3px; font-size: 0.9em; opacity: 0.7; }
  .hint { position: fixed; bottom: 20px; left: 30px; font-size: 13px; color: rgba(255,255,255,0.4); z-index: 100; transition: opacity 0.5s; }
  .nav-btn { position: fixed; top: 50%; transform: translateY(-50%); width: 50px; height: 50px; border-radius: 50%; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); color: #fff; font-size: 22px; cursor: pointer; backdrop-filter: blur(10px); transition: all 0.3s; z-index: 100; display: flex; align-items: center; justify-content: center; }
  .nav-btn:hover { background: rgba(255,217,61,0.25); border-color: #ffd93d; transform: translateY(-50%) scale(1.1); }
  .nav-btn.prev { left: 20px; }
  .nav-btn.next { right: 20px; }
  .final { font-size: clamp(40px, 7vw, 90px); background: linear-gradient(90deg, #ffd93d, #ff6b9d, #6bcB77, #4d96ff); background-size: 300% 300%; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; animation: shine 4s ease infinite; font-weight: 900; }
  @keyframes shine { 0%,100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
  .download-btn { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); padding: 12px 26px; background: linear-gradient(90deg, #ffd93d, #6bcB77); color: #0a0e27; font-weight: 700; font-size: 15px; border: none; border-radius: 30px; cursor: pointer; z-index: 100; box-shadow: 0 6px 25px rgba(255,217,61,0.35); transition: transform 0.3s, box-shadow 0.3s; font-family: inherit; }
  .download-btn:hover { transform: translateX(-50%) scale(1.08); box-shadow: 0 8px 35px rgba(107,203,119,0.5); }
  @media (max-width: 768px) {
    .slide { padding: 40px 20px; }
    .compare { grid-template-columns: 1fr; gap: 15px; }
    .nav-btn { width: 40px; height: 40px; font-size: 18px; }
    .card { padding: 18px; }
    .hint { display: none; }
    .download-btn { font-size: 13px; padding: 10px 20px; }
  }
</style>
</head>
<body>

<div class="bg"></div>
<div class="particles" id="particles"></div>
<div class="progress" id="progress"></div>
<div class="counter"><span id="current">1</span> / <span id="total">11</span></div>

<button class="nav-btn prev" onclick="changeSlide(-1)">‹</button>
<button class="nav-btn next" onclick="changeSlide(1)">›</button>

<!-- Слайд 1 -->
<div class="slide title-slide active">
  <div class="emoji-big">⚡💰</div>
  <h1>Профессии моих родителей</h1>
  <div class="stickers">
    <div class="sticker">👨‍🔧</div>
    <div class="sticker">💡</div>
    <div class="sticker">👩‍💼</div>
  </div>
  <p class="author">Выполнил: Соколов Дмитрий</p>
</div>

<!-- Слайд 2 -->
<div class="slide">
  <h2>👨‍👩‍👦 Мои родители</h2>
  <p>У меня замечательные родители. Мой папа работает <b style="color:#ffd93d">электромонтёром</b> в компании «Россети». Моя мама работает <b style="color:#6bcB77">бухгалтером</b>.</p>
  <p>Их профессии очень разные, но обе они очень важны и нужны людям.</p>
</div>

<!-- Слайд 3 -->
<div class="slide">
  <div class="emoji-big">⚡</div>
  <h2>Профессия папы — Электромонтёр</h2>
  <p>Электромонтёр — это специалист, который работает с электричеством. Он обеспечивает бесперебойную подачу энергии.</p>
  <p>Компания <b style="color:#ffd93d">«Россети»</b> — крупнейшая энергетическая компания России. Она отвечает за то, чтобы электричество доходило до наших домов, школ, больниц и заводов.</p>
</div>

<!-- Слайд 4 -->
<div class="slide">
  <h2>🔧 Каждый день мой папа:</h2>
  <ul>
    <li>Следит за исправностью линий электропередач и подстанций</li>
    <li>Проводит ремонт и замену старого оборудования</li>
    <li>Устраняет аварии, чтобы в домах всегда был свет</li>
    <li>Работает с высоким напряжением</li>
  </ul>
</div>

<!-- Слайд 5 -->
<div class="slide">
  <div class="emoji-big">💡</div>
  <h2>Почему это важно?</h2>
  <p>Без электричества невозможно представить современную жизнь. Оно нужно для работы заводов, освещения улиц, работы компьютеров и бытовой техники.</p>
  <p>Профессия папы обеспечивает комфорт и безопасность миллионов людей. Это работа для <b style="color:#ffd93d">сильных и ответственных</b> людей.</p>
</div>

<!-- Слайд 6 -->
<div class="slide">
  <div class="emoji-big">📊</div>
  <h2>Профессия мамы — Бухгалтер</h2>
  <p>Бухгалтер — специалист, который ведёт учёт финансовых операций в компании. Он следит за тем, чтобы деньги были учтены правильно: сколько компания заработала, сколько потратила, сколько налогов нужно заплатить.</p>
  <p>Это очень кропотливая и точная работа, требующая внимания и знаний.</p>
</div>

<!-- Слайд 7 -->
<div class="slide">
  <h2>📝 Каждый день моя мама:</h2>
  <ul>
    <li>Работает с документами и первичными отчётами</li>
    <li>Начисляет заработную плату сотрудникам</li>
    <li>Рассчитывает налоги и отчисления в фонды</li>
    <li>Готовит отчёты для руководства и государственных органов</li>
  </ul>
</div>

<!-- Слайд 8 -->
<div class="slide">
  <div class="emoji-big">💼</div>
  <h2>Почему это важно?</h2>
  <p>Ни одна компания не может работать без бухгалтера. Именно он следит за финансовым здоровьем организации.</p>
  <p>Благодаря работе мамы компания работает законно, вовремя платит налоги, а сотрудники получают зарплату. Это работа для <b style="color:#6bcB77">умных, внимательных и организованных</b> людей.</p>
</div>

<!-- Слайд 9 -->
<div class="slide">
  <h2>⚖️ Сравнение профессий</h2>
  <div class="compare">
    <div class="card dad">
      <h3>⚡ Электромонтёр</h3>
      <div class="row"><b>Что делает?</b>Работает с электричеством</div>
      <div class="row"><b>Где работает?</b>На улице, на подстанциях</div>
      <div class="row"><b>Что нужно?</b>Сила, ответственность, знание техники</div>
    </div>
    <div class="card mom">
      <h3>💰 Бухгалтер</h3>
      <div class="row"><b>Что делает?</b>Работает с финансами и документами</div>
      <div class="row"><b>Где работает?</b>В офисе, за компьютером</div>
      <div class="row"><b>Что нужно?</b>Внимательность, точность, знание законов</div>
    </div>
  </div>
</div>

<!-- Слайд 10 -->
<div class="slide">
  <div class="emoji-big">❤️</div>
  <h2>Я горжусь ими!</h2>
  <p>Мои родители выбрали очень разные, но невероятно важные профессии. <b style="color:#ffd93d">Папа дарит людям свет</b>, а <b style="color:#6bcB77">мама наводит порядок в финансах</b>.</p>
  <p>Их работа делает нашу жизнь лучше и комфортнее. Я очень горжусь ими и благодарен за их труд!</p>
</div>

<!-- Слайд 11 -->
<div class="slide">
  <div class="final">Спасибо за внимание!</div>
  <div class="stickers" style="margin-top:50px">
    <div class="sticker">⚡</div>
    <div class="sticker">💰</div>
    <div class="sticker">🙏</div>
  </div>
</div>

<div class="hint">← → или пробел для переключения · свайп на телефоне</div>

<button class="download-btn" onclick="downloadFile()">⬇ Скачать эту презентацию</button>

<script>
  const slides = document.querySelectorAll('.slide');
  const total = slides.length;
  let current = 0;
  document.getElementById('total').textContent = total;

  function update() {
    slides.forEach((s, i) => {
      s.classList.remove('active', 'prev');
      if (i === current) s.classList.add('active');
      else if (i < current) s.classList.add('prev');
    });
    document.getElementById('current').textContent = current + 1;
    document.getElementById('progress').style.width = ((current + 1) / total * 100) + '%';
  }
  function changeSlide(dir) {
    current = Math.max(0, Math.min(total - 1, current + dir));
    update();
  }
  document.addEventListener('keydown', e => {
    if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'PageDown') { e.preventDefault(); changeSlide(1); }
    if (e.key === 'ArrowLeft' || e.key === 'PageUp') { e.preventDefault(); changeSlide(-1); }
    if (e.key === 'Home') { current = 0; update(); }
    if (e.key === 'End') { current = total - 1; update(); }
  });
  let touchStartX = 0;
  document.addEventListener('touchstart', e => touchStartX = e.touches[0].clientX);
  document.addEventListener('touchend', e => {
    const diff = touchStartX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 50) changeSlide(diff > 0 ? 1 : -1);
  });
  const icons = ['⚡', '💡', '💰', '📊', '🔌', '📈', '🧾', '🔧'];
  const particlesBox = document.getElementById('particles');
  for (let i = 0; i < 20; i++) {
    const span = document.createElement('span');
    span.textContent = icons[Math.floor(Math.random() * icons.length)];
    span.style.left = Math.random() * 100 + '%';
    span.style.animationDuration = (15 + Math.random() * 20) + 's';
    span.style.animationDelay = (Math.random() * 20) + 's';
    span.style.fontSize = (20 + Math.random() * 30) + 'px';
    particlesBox.appendChild(span);
  }
  function downloadFile() {
    const html = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
    const blob = new Blob([html], { type: 'text/html;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'Профессии-моих-родителей.html';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }
  update();
</script>

</body>
  </html>
